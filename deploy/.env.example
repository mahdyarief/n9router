# n9router Environment Configuration
# Copy to .env and edit before deploying

# Dashboard login password (first-time login + INITIAL_PASSWORD fallback)
INITIAL_PASSWORD=changeme

# Token swap rotation strategy: round-robin | random | least-used
TOKEN_SWAP_STRATEGY=round-robin

# Dashboard bind port (default: 20128)
DASHBOARD_PORT=20128

# MITM proxy bind port (default: 443, must be privileged)
MITM_PORT=443

# Node environment
NODE_ENV=production
